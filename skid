local Boot = {Connections = {}, Stage = "Preflight"}

function Boot.Service(name, optional)
    local ok, service = pcall(function() return game:GetService(name) end)
    if not ok then
        if optional then return nil end
        error("Service unavailable: " .. name .. ": " .. tostring(service), 0)
    end
    if type(cloneref) == "function" then
        local cloned, value = pcall(cloneref, service)
        if cloned and value then service = value end
    end
    return service
end

function Boot.Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Boot.Connections, connection)
    return connection
end

function Boot.Mount(gui)
    local candidates = {}
    if type(gethui) == "function" then
        local ok, value = pcall(gethui)
        if ok and value then table.insert(candidates, value) end
    end
    if Boot.PlayerGui then table.insert(candidates, Boot.PlayerGui) end
    local core = Boot.Service("CoreGui", true)
    if core then table.insert(candidates, core) end
    for _, parent in ipairs(candidates) do
        local ok = pcall(function() gui.Parent = parent end)
        if ok and gui.Parent == parent then return end
    end
    error("No writable UI parent. Run this on the Roblox client after PlayerGui is ready.", 0)
end

function Boot.Request(options)
    local candidates = {
        type(syn) == "table" and syn.request or false,
        type(http) == "table" and http.request or false,
        http_request or false,
        type(fluxus) == "table" and fluxus.request or false,
        request or false
    }
    local lastError = "HTTP is unavailable"
    for _, candidate in ipairs(candidates) do
        if type(candidate) == "function" then
            local ok, response = pcall(candidate, options)
            if ok and type(response) == "table" and response.Success ~= false then
                local code = tonumber(response.StatusCode or response.Status or 200)
                if code and code >= 200 and code < 300 and type(response.Body) == "string" then
                    return response
                end
            end
            if not ok then lastError = tostring(response) end
        end
    end
    local ok, body = pcall(function() return game:HttpGet(options.Url) end)
    if ok and type(body) == "string" then return {StatusCode = 200, Body = body} end
    error(lastError .. "; " .. tostring(body), 0)
end

