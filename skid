function Perf.CompareLetters(a, b)
    if math.abs(a.X - b.X) > 2 then return a.X < b.X end
    return a.Id < b.Id
end

local function GetCurrentGameWord(providedFrame)
    local frame = providedFrame
    if not frame then
        local player = Players.LocalPlayer
        local gui = player and player:FindFirstChild("PlayerGui")
        local inGame = gui and gui:FindFirstChild("InGame")
        frame = inGame and inGame:FindFirstChild("Frame")
    end
    local container = frame and frame:FindFirstChild("CurrentWord")
    if not container then return "", false end
    local raw, ordered, pieces = Perf.LetterRaw, Perf.LetterOrder, Perf.LetterParts
    local count, dirty = 0, Perf.LetterContainer ~= container
    Perf.LetterContainer = container
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("GuiObject") and child.Visible then
            local label = child:FindFirstChild("Letter")
            if label and label:IsA("TextLabel") and label.TextTransparency < 1 then
                count = count + 1
                local data = raw[count]
                if not data then data = {} raw[count] = data dirty = true end
                local x, id = child.AbsolutePosition.X, tonumber(child.Name) or 0
                if data.Obj ~= child or data.Txt ~= label or data.X ~= x or data.Id ~= id then
                    data.Obj, data.Txt, data.X, data.Id = child, label, x, id
                    dirty = true
                end
            end
        end
    end
    if count ~= Perf.LetterCount then dirty = true Perf.LetterCount = count end
    for i = #raw, count + 1, -1 do raw[i] = nil end
    if dirty then
        for i = 1, count do ordered[i] = raw[i] end
        for i = #ordered, count + 1, -1 do ordered[i] = nil end
        table.sort(ordered, Perf.CompareLetters)
    end
    local censored = false
    for i = 1, count do
        local value = tostring(ordered[i].Txt.Text)
        if value:find("#", 1, true) or value:find("*", 1, true) then censored = true end
        pieces[i] = value
    end
    for i = #pieces, count + 1, -1 do pieces[i] = nil end
    return table.concat(pieces):lower():gsub(" ", ""), censored
end

function Guard.IsOwn(text)
    local player = Players.LocalPlayer
    if not player then return false end
    local name = player.Name
    if text:sub(1, #name) ~= name then name = player.DisplayName end
    if text:sub(1, #name) ~= name then return false end
    local nextChar = text:sub(#name + 1, #name + 1)
    return nextChar == "" or nextChar:match("[%s%p]") ~= nil
end

function Guard.Signature(word)
    local counts = {}
    for i = 1, #word do
        local byte = word:byte(i)
        counts[byte] = (counts[byte] or 0) + 1
    end
    return counts
end

function Guard.IsShuffle(word, prompt)
    if #word ~= #prompt then return false end
    local counts = Guard.Signature(word)
    local expected = Guard.PromptCounts
    if not expected then return false end
    for byte, count in pairs(expected) do if counts[byte] ~= count then return false end end
    return true
end

function Guard.SavePrompt(word)
    if word == "" or word:find("[^a-z]") then return end
    if Guard.Prompt and (Guard.Intimidated or Guard.Burst >= 2) and Guard.IsShuffle(word, Guard.Prompt) then return end
    Guard.Prompt = word
    Guard.PromptCounts = Guard.Signature(word)
    Guard.Intimidated = false
end

function Guard.Word(frame)
    local raw, censored = GetCurrentGameWord(frame)
    if not Guard.IsOwn(Guard.Text or "") then return raw, censored end
    if not Guard.Prompt and raw ~= "" then Guard.SavePrompt(raw) end
    local prompt = Guard.Prompt
    if prompt and not censored and #raw >= #prompt then
        local prefix = raw:sub(1, #prompt)
        if prefix ~= prompt and Guard.IsShuffle(prefix, prompt) then
            Guard.Intimidated = true
            return prompt .. raw:sub(#prompt + 1), false
        end
    end
    return raw, censored
end

function Guard.Observe(text)
    if text == Guard.Text then return end
    local key = text:gsub("starting with:.*$", "")
    Guard.Text = text
    if key == Guard.OwnerKey then return end
    Guard.OwnerKey = key
    local now = Perf.Clock()
    Guard.Text = text
    Guard.Epoch = Guard.Epoch + 1
    Guard.Burst = now - Guard.LastChange <= 0.12 and math.min(Guard.Burst + 1, 100) or 1
    Guard.LastChange = now
    if Guard.IsOwn(text) then
        Guard.Required = text:match("starting with:%s*([A-Za-z]+)")
        if Guard.Burst < 8 then
            local word, censored = GetCurrentGameWord(Guard.Frame)
            if not censored then Guard.SavePrompt(word) end
        end
    end
    Guard.ReadyAt = now + (Guard.Burst >= 8 and 0.4 or 0.15)
    isMyTurnLogDetected = false
    currentBestMatch = nil
    Perf.Version = Perf.Version + 1
    Perf.Pending = nil
    isAutoPlayScheduled = false
    forceUpdateList = true
end

function Guard.Bind(label)
    if label == Guard.Label then return end
    if Guard.Connection then Guard.Connection:Disconnect() Guard.Connection = nil end
    Guard.Label = label
    Guard.Observe(label and label.Text or "")
    if label then
        Guard.Connection = label:GetPropertyChangedSignal("Text"):Connect(function()
            Guard.Observe(label.Text)
        end)
    end
end

local function GetTurnInfo(providedFrame)
    local frame = providedFrame
    if not frame then
        local player = Players.LocalPlayer
        local gui = player and player:FindFirstChild("PlayerGui")
        local inGame = gui and gui:FindFirstChild("InGame")
        frame = inGame and inGame:FindFirstChild("Frame")
    end
    Guard.Frame = frame
    local label = frame and frame:FindFirstChild("Type")
    if label and label:IsA("TextLabel") and label.Visible then
        Guard.Bind(label)
        Guard.Observe(label.Text)
        local own = Guard.IsOwn(label.Text)
        local required = label.Text:match("starting with:%s*([A-Za-z]+)")
        if own and Guard.Required then required = Guard.Required end
        return own, required
    end
    Guard.Bind(nil)
    if isMyTurnLogDetected and tick() < turnExpiryTime then return true, logRequiredLetters end
    return false, nil
end

function Guard.Stable()
    return not unloaded and Perf.Clock() >= Guard.ReadyAt
end

function Guard.Check()
    if not Guard.Active then return end
    local own = GetTurnInfo()
    if unloaded or Guard.Active ~= Guard.Epoch or not Guard.Stable() or (not Guard.Bypass and not own) then
        error(Guard.Cancel, 0)
    end
end

function Guard.Verify(targetWord, originalWord)
    local deadline = Perf.Clock() + 1.5
    while Perf.Clock() < deadline do
        Guard.Check()
        local current = Guard.Word()
        if current == "" or (current ~= targetWord and current ~= originalWord) then return true end
        task.wait(0.1)
    end
    return false
end

