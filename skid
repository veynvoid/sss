    local function ParseWords(content)
        local parsed = {}
        local seen = {}
        local stats = {Entries = 0, Unique = 0, Duplicates = 0, Invalid = 0}
        Boot.DictionaryStats = stats
        if type(content) ~= "string" then return parsed end
        content = content:gsub("^\239\187\191", "")
        local parseCount, parseSlice = 0, os.clock()
        for word in content:gmatch("[^\r\n]+") do
            parseCount = parseCount + 1
            if parseCount % 256 == 0 and os.clock() - parseSlice >= 0.002 then
                task.wait()
                parseSlice = os.clock()
            end
            if word:match("%S") then stats.Entries = stats.Entries + 1 end
            local clean = word:match("^%s*([A-Za-z]+)%s*$")
            if clean then
                clean = clean:lower()
                if not seen[clean] then
                    seen[clean] = true
                    table.insert(parsed, clean)
                    stats.Unique = stats.Unique + 1
                else
                    stats.Duplicates = stats.Duplicates + 1
                end
            elseif word:match("%S") then
                stats.Invalid = stats.Invalid + 1
            end
        end
        return parsed
    end
    local done, downloaded = false, nil
    LoadingStatus.Text = "Fetching casual dictionary (12s maximum)..."
