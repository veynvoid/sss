function Perf.Poll(now)
        local player = Players.LocalPlayer
        local gui = player and player:FindFirstChild("PlayerGui")
        local frame = gui and gui:FindFirstChild("InGame") and gui.InGame:FindFirstChild("Frame")

        if isTyping and (tick() - lastTypingStart) > 15 then
            Guard.Epoch = Guard.Epoch + 1
            Guard.ReadyAt = Perf.Clock() + 0.4
            isAutoPlayScheduled = false
            UI.StatusText.Text = "Canceling stale typing job"
            UI.StatusText.TextColor3 = THEME.Warning
        end
        
        local isVisible = false
        if frame and frame.Parent then
            if frame.Parent:IsA("ScreenGui") then
                isVisible = frame.Parent.Enabled
            elseif frame.Parent:IsA("GuiObject") then
                isVisible = frame.Parent.Visible
            end
        end

        Perf.Active = isVisible
        local seconds = nil
        if isVisible then
            local circle = frame:FindFirstChild("Circle")
            local timerLbl = circle and circle:FindFirstChild("Timer") and circle.Timer:FindFirstChild("Seconds")
            
            if timerLbl then
                local timeText = timerLbl.Text
                seconds = tonumber(timeText:match("([%d%.]+)"))
                
                if not StatsData.Frame.Visible then StatsData.Frame.Visible = true end
                if Perf.TimerText ~= timeText then
                    Perf.TimerText = timeText
                    StatsData.Timer.Text = timeText
                end
                local urgent = seconds and seconds < 3 or false
                if urgent ~= Perf.TimerUrgent then
                    Perf.TimerUrgent = urgent
                    StatsData.Timer.TextColor3 = urgent and Color3.fromRGB(255, 80, 80) or THEME.Text
                end
            end
        else
            if StatsData.Frame.Visible then StatsData.Frame.Visible = false end
        end

        local isMyTurn, requiredLetter = GetTurnInfo(frame)
        if not Guard.Stable() then
            if UI.StatusText.Text ~= "Turn reversal detected; waiting for stable turn" then
                UI.StatusText.Text = "Turn reversal detected; waiting for stable turn"
                UI.StatusText.TextColor3 = THEME.Warning
            end
            return
        end
        
        if isVisible then
            cachedDetected, cachedCensored = Guard.Word(frame)
            lastWordCheck = now
        else
            cachedDetected, cachedCensored = "", false
        end
        local detected, censored = cachedDetected, cachedCensored
        local guardText = Guard.Prompt and ("Prompt: " .. Guard.Prompt .. (Guard.Intimidated and " / shuffle blocked" or " / protected")) or "CASUAL / prompt protection on"
        if UI.GuardInfo.Text ~= guardText then UI.GuardInfo.Text = guardText end

        if Perf.SearchPending and Perf.Clock() >= Perf.SearchDue then
            Perf.SearchPending = false
            UpdateList(lastDetected, lastRequiredLetter)
        end

        if Guard.Stable() and Perf.Clock() >= Guard.NextAttempt and panicMode and isVisible and isMyTurn and not isTyping and seconds and seconds < 1.5 and now >= Perf.NextPanic then
            Perf.NextPanic = now + 0.25
            local char = (requiredLetter or ""):lower()
            local bucket = Buckets[char]
            if bucket then
                local bestWord = nil
                local bestLen = 999
                local prefix = detected ~= "" and detected or char
                local startIndex = BinarySearchStart(bucket, prefix)
                local scanSlice = Perf.Clock()
                if startIndex ~= -1 then
                    for i = startIndex, #bucket do
                        local word = bucket[i]
                        if word:sub(1, #prefix) ~= prefix then break end
                        if not Blacklist[word] and not UsedWords[word] and #word < bestLen then
                            bestWord, bestLen = word, #word
                        end
                        if (i - startIndex) % 128 == 127 and Perf.Clock() - scanSlice >= 0.002 then
                            task.wait()
                            scanSlice = Perf.Clock()
                            if unloaded then return end
                        end
                    end
                end
                
                if bestWord then
                    UI.StatusText.Text = "PANIC SAVE!"
                    UI.StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
                    task.spawn(SmartType, bestWord, detected, false)
                end
            end
        end

        if autoJoin and not Perf.JoinBusy and (now - lastAutoJoinCheck > AUTO_JOIN_RATE) then
            lastAutoJoinCheck = now
            Perf.JoinBusy = true
            task.spawn(function()
                local joinOk, joinError = pcall(function()
                local displayMatch = gui and gui:FindFirstChild("DisplayMatch")
                local dFrame = displayMatch and displayMatch:FindFirstChild("Frame")
                local matches = dFrame and dFrame:FindFirstChild("Matches")
                
                if matches then
                    for _, matchFrame in ipairs(matches:GetChildren()) do
                        if (matchFrame:IsA("Frame") or matchFrame:IsA("GuiObject")) and matchFrame.Name ~= "UIListLayout" then
                            local joinBtn = matchFrame:FindFirstChild("Join")
                            local title = matchFrame:FindFirstChild("Title")
                            
                            local isLastLetter = false
                            local titleText = "N/A"
                            if title and title:IsA("TextLabel") then
                                titleText = title.Text
                                if titleText:find("Last Letter") then
                                    isLastLetter = true
                                end
                            end

                            local idx = tonumber(matchFrame.Name)
                            local allowed = true
                            if idx then
                                if idx >= 1 and idx <= 4 then allowed = Config.AutoJoinSettings._1v1
                                elseif idx >= 5 and idx <= 8 then allowed = Config.AutoJoinSettings._4p
                                elseif idx == 9 then allowed = Config.AutoJoinSettings._8p
                                end
                            end

                            if joinBtn and joinBtn.Visible and isLastLetter and allowed then
                                local matchId = matchFrame.Name
                                if (tick() - (JoinDebounce[matchId] or 0)) > 2 then
                                    JoinDebounce[matchId] = tick()
                                    task.wait(0.5)
                                    if unloaded or not autoJoin or not joinBtn.Parent then return end
                                    
                                    local clicked = false
                                    if getconnections then
                                        if joinBtn:IsA("GuiButton") then
                                            local success, conns = pcall(function() return getconnections(joinBtn.MouseButton1Click) end)
                                            if success and conns then
                                                for _, conn in ipairs(conns) do
                                                    if conn.Fire then conn:Fire() end
                                                    if conn.Function then
                                                        task.spawn(conn.Function)
                                                    end
                                                    clicked = true
                                                end
                                            end
                                        end
                                    end
                                    
                                    if not clicked then
                                        local cd = joinBtn:FindFirstChildWhichIsA("ClickDetector")
                                        if cd then
                                            fireclickdetector(cd)
                                            clicked = true
                                        end
                                    end

                                    if not clicked then
                                        local absPos = joinBtn.AbsolutePosition
                                        local absSize = joinBtn.AbsoluteSize
                                        local centerX = absPos.X + absSize.X/2
                                        local centerY = absPos.Y + absSize.Y/2
                                        
                                        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
                                        task.wait(0.05)
                                        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
                end)
                Perf.JoinBusy = false
                if not joinOk then Perf.Report(joinError) end
            end)
        end

        local typeLbl = frame and frame:FindFirstChild("Type")
        local typeVisible = typeLbl and typeLbl.Visible
        if not isVisible then
            Guard.LeftAt = Guard.LeftAt or now
        end
        local newRound = isVisible and (Guard.RoundFrame ~= frame or (Guard.LeftAt and now - Guard.LeftAt > 1))
        if isVisible then Guard.RoundFrame = frame Guard.LeftAt = nil end
        if newRound then
            Guard.Prompt, Guard.PromptCounts, Guard.Required = nil, nil, nil
            Guard.Intimidated = false
            Guard.Word(frame)
            UsedWords = {}
            Perf.Version = Perf.Version + 1
            forceUpdateList = true
            UI.StatusText.Text = "New Round - Words Reset"
            UI.StatusText.TextColor3 = THEME.Success
        end
        lastTypeVisible = typeVisible
        if censored then
            if UI.StatusText.Text ~= "Word is Censored" then
                UI.StatusText.Text = "Word is Censored"
                UI.StatusText.TextColor3 = THEME.Warning
                Tween(UI.StatusDot, {BackgroundColor3 = THEME.Warning})
                
                for _, btn in ipairs(ButtonCache) do btn.Visible = false end
                StatsData.Count.Text = "Words: 0"
            end
            
            listUpdatePending = false
            forceUpdateList = false
            currentBestMatch = nil
            lastDetected = detected
            lastRequiredLetter = requiredLetter
        end
        
        if listUpdatePending and (now - lastInputTime > LIST_DEBOUNCE) then
            listUpdatePending = false
            UpdateList(lastDetected, lastRequiredLetter)
            

        end

        if not isVisible then
            if UI.StatusText.Text ~= "Not in Round" then
                UI.StatusText.Text = "Not in Round"
                UI.StatusText.TextColor3 = THEME.SubText
                Tween(UI.StatusDot, {BackgroundColor3 = THEME.SubText})
                for _, btn in ipairs(ButtonCache) do btn.Visible = false end
                StatsData.Count.Text = "Words: 0"
            end
            lastDetected = "---"
        elseif detected ~= lastDetected or requiredLetter ~= lastRequiredLetter or forceUpdateList then
            currentBestMatch = nil
            Perf.Version = Perf.Version + 1
            lastDetected = detected
            lastRequiredLetter = requiredLetter
            
            if detected == "" and not forceUpdateList then
                UI.StatusText.Text = "Waiting..."
                UI.StatusText.TextColor3 = THEME.SubText
                Tween(UI.StatusDot, {BackgroundColor3 = THEME.SubText})
                
                UpdateList("", requiredLetter)
                listUpdatePending = false
                

            else
                if detected ~= "" then
                    local isCompleted = #detected > 2 and Perf.WordSet[detected] == true

                    if isCompleted then
                        UI.StatusText.Text = "Completed: " .. detected .. " <font color=\"rgb(100,255,140)\">✓</font>"
                        UI.StatusText.TextColor3 = THEME.Success
                        Tween(UI.StatusDot, {BackgroundColor3 = THEME.Success})
                    else
                        UI.StatusText.Text = "Input: " .. detected
                        UI.StatusText.TextColor3 = THEME.Accent
                        Tween(UI.StatusDot, {BackgroundColor3 = THEME.Warning})
                    end
                end
                
                if forceUpdateList then
                    listUpdatePending = true
                    lastInputTime = 0
                    forceUpdateList = false
                else
                    listUpdatePending = true
                    lastInputTime = now
                end
            end
        end

        if Guard.Stable() and Perf.Clock() >= Guard.NextAttempt and autoPlay and not isTyping and not isAutoPlayScheduled and currentBestMatch and detected == lastDetected then
            local isMyTurnCheck, _ = GetTurnInfo(frame)
            if isMyTurnCheck then
                isAutoPlayScheduled = true
                local targetWord = currentBestMatch
                local snapshotDetected = lastDetected
                local scheduledEpoch = Guard.Epoch
                
                task.spawn(function()
                    local delay = isBlatant and 0.15 or (0.8 + math.random() * 0.5)
                    task.wait(delay)
                    
                    local stillMyTurn, _ = GetTurnInfo()
                    if not unloaded and scheduledEpoch == Guard.Epoch and Guard.Stable() and autoPlay and not isTyping and Guard.Word() == snapshotDetected and stillMyTurn then
                         SmartType(targetWord, snapshotDetected, false)
                    end
                    if scheduledEpoch == Guard.Epoch then isAutoPlayScheduled = false end
                end)
            end
        end
end

